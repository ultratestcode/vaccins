# Variables lues par le code — copier ce fichier vers .env.local et remplir.
# Base locale (dev et tests) : chemin du fichier SQLite. Défaut : data/vaccins.db
VACCINS_DB_PATH=
# Base managée (prod) : si TURSO_URL est défini, l'app parle à Turso et
# VACCINS_DB_PATH est ignoré. Base Turso distincte de celle de pipeline.
# Ne jamais commiter .env.local.
TURSO_URL=
TURSO_AUTH_TOKEN=
